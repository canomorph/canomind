{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CanoMind",
  "version": "0.9.0",
  "identifier": "app.canomind",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CanoMind",
        "width": 1280,
        "height": 800,
        "minWidth": 560,
        "minHeight": 540,
        "decorations": false,
        "dragDropEnabled": false,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
        "dmg",
        "app",
        "deb",
        "appimage",
        "msi",
        "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
   ],
  "macOS": {
    "signingIdentity": "-"
  },
  "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
